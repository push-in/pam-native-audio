{
    "name": "pushinbr/pam-native-audio",
    "description": "Headless native audio player for PAM Native: queues, playback rate, audio focus, caching and proximity earpiece routing for voice notes.",
    "type": "pam-native-plugin",
    "keywords": ["pam-native", "audio", "player", "voice-notes", "exoplayer", "avplayer", "android", "ios"],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.0.35"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Audio\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
