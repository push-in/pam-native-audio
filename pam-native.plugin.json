{
    "$schema": "vendor/pushinbr/pam-native/resources/pam-native.plugin.schema.json",
    "version": 1,
    "protocol": 1,
    "pamNative": {
        "minimum": "1.0.35",
        "maximumExclusive": "2.0.0"
    },
    "capabilities": {
        "required": [
            "runtime.modules.v1",
            "wire.binary.v1"
        ],
        "optional": []
    },
    "php": {
        "provider": "Pam\\Native\\Audio\\AudioPluginProvider"
    },
    "android": {
        "namespace": "dev.pam.audio",
        "minSdk": 26,
        "permissions": [
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.WAKE_LOCK"
        ],
        "dependencies": [
            "androidx.media3:media3-exoplayer:1.10.1",
            "androidx.media3:media3-datasource:1.10.1",
            "androidx.media3:media3-database:1.10.1"
        ],
        "sourceDirs": [
            "android/src/main/kotlin"
        ],
        "manifest": "android/src/main/AndroidManifest.xml",
        "consumerRules": "android/consumer-rules.pro"
    },
    "ios": {
        "minimumVersion": "15.0",
        "sourceDirs": [
            "ios/Sources"
        ],
        "frameworks": [
            "AVFoundation",
            "CoreMedia"
        ]
    },
    "idl": "pam-native.idl.json",
    "modules": [
        {
            "name": "audio-player",
            "class": "dev.pam.audio.AudioPlayerModule",
            "iosClass": "AudioPlayerModule"
        }
    ],
    "views": []
}
