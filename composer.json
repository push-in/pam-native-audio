{
    "name": "pushinbr/pam-native-audio",
    "description": "Native audio for PAM Native: headless player (queues, playback rate, audio focus, caching, proximity earpiece routing) and the voice recorder.",
    "type": "pam-native-plugin",
    "keywords": [
        "pam-native",
        "audio",
        "player",
        "voice-notes",
        "exoplayer",
        "avplayer",
        "android",
        "ios"
    ],
    "license": "Apache-2.0",
    "require": {
        "php": "^8.5",
        "pushinbr/pam-native": "^1.46"
    },
    "require-dev": {
        "pushinbr/pam-native-testing": "^0.2.1"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Native\\Audio\\": "src/"
        }
    },
    "extra": {
        "pam-native": {
            "plugin": "pam-native.plugin.json"
        }
    },
    "scripts": {
        "test": "php tests/run.php"
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    }
}
